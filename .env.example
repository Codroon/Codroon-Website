# =====================================================================
# Codroon — environment
# Copy to .env.local and fill in. .env* is gitignored; never commit
# real values.
# =====================================================================

# ---- Supabase -------------------------------------------------------
# Project URL. Safe to expose — it ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (publishable) key. Also ships to the browser, which is why the
# RLS policies in supabase/migrations are the only thing protecting the
# data. With this key a visitor can insert an estimate, insert a modal
# lead, and read or update ONE estimate if they hold its short code.
# Nothing else — verify with: node scripts/verify-rls-live.mjs
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Bypasses RLS entirely — it can read every lead you
# have. SERVER-SIDE ONLY: never import it into a client component,
# never prefix it with NEXT_PUBLIC_, and never reference it from
# anything under a "use client" boundary. The estimator does not need
# it at runtime; it is here for admin and analytics access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Email (Resend) -------------------------------------------------
# When RESEND_API_KEY or FROM_EMAIL is unset, /api/lead still writes the
# lead row and returns success — it logs what it would have sent instead.
# A lead is never lost because email is unconfigured or failing.
#
# ⚠️ codroon.com must be verified in Resend with SPF and DKIM before
# anything sends. If an SPF record already exists for the domain, merge
# Resend's include into it — a second, separate SPF record makes the
# check fail outright. See README.
RESEND_API_KEY=

# Verified sender on the SENDING subdomain — this is what carries SPF
# and DKIM. Bare address or "Name <address>". Defaults to
# "Codroon <info@send.codroon.com>" when unset (src/config/email.ts).
FROM_EMAIL=Codroon <info@send.codroon.com>

# The mailbox a human reads. Set as Reply-To on EVERY send, both
# visitor emails and notifications — replying to the sending subdomain
# reaches nobody. Defaults to sales@codroon.com.
REPLY_TO_EMAIL=sales@codroon.com

# Where every lead notification goes. Defaults to sales@codroon.com.
NOTIFICATION_EMAIL=sales@codroon.com

# ---- Scheduling -----------------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/codroon-info/30min

# ---- Cron -----------------------------------------------------------
# Shared secret for /api/cron/*. Vercel sends it as an Authorization
# header; requests without it are rejected. Generate something long and
# random — these routes read every lead you have.
CRON_SECRET=
